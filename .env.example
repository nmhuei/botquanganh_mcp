MCP_BIND_HOST=127.0.0.1
MCP_PORT=18427

# ChatGPT-friendly Streamable HTTP behavior.
MCP_JSON_RESPONSE=true
MCP_STATELESS_HTTP=true

# Required when exposing the MCP server over HTTP.
REQUIRE_AUTH=false
GATEWAY_TOKEN=

# Set true only when the server is behind a trusted reverse proxy such as Cloudflare Tunnel.
TRUST_PROXY_HEADERS=true
# Optional comma-separated browser origins allowed by the HTTP API. Empty disables CORS origins.
ALLOWED_ORIGINS=

# Host access boundary. Relative tool paths are resolved from this directory.
HOST_WORKSPACE_DIR=~
HOST_RESTRICT_TO_WORKSPACE=true
# Optional narrower read/write roots. Empty means HOST_WORKSPACE_DIR.
HOST_READ_SCOPE=
HOST_WRITE_SCOPE=
# Comma-separated globs denied even when they fall inside the read scope.
HOST_READ_DENY_GLOBS=

# Default working directory. Relative operations fallback to this directory.
# Defaults to HOST_WORKSPACE_DIR if omitted.
HOST_DEFAULT_DIR=~/Workspace/botquanganh_mcp_workspace

# guarded: allow normal host commands and block explicit destructive/privileged actions.
# allowlist: additionally restrict commands to the built-in list + HOST_ALLOWED_COMMANDS.
HOST_COMMAND_POLICY=guarded
HOST_ALLOWED_COMMANDS=all

# Environment passed to child commands. Sensitive token/secret variables are
# removed even when inheritance is enabled unless explicitly allowlisted.
# Shell startup injection variables such as BASH_ENV and LD_PRELOAD are always removed.
HOST_INHERIT_ENV=true
HOST_ENV_ALLOWLIST=

# Local guides and installed-tool catalog used by host_knowledge.
HOST_KNOWLEDGE_DIR=./knowledge
HOST_TOOL_CACHE_SECONDS=300

# Resource limits.
MAX_SINGLE_FILE_BYTES=3000000
MAX_OUTPUT_BYTES=500000
# Default execution timeout per command (in seconds, 60 = 1 minute; 0 = unlimited).
DEFAULT_TIMEOUT_SECONDS=60
# Upper limit for caller-requested command timeouts (in seconds, 300 = 5 minutes).
MAX_TIMEOUT_SECONDS=300
MAX_CONCURRENT_COMMANDS=100
COMMAND_QUEUE_TIMEOUT_SECONDS=2

# Maximum wall-clock time for recursive text search before returning partial results.
SEARCH_TEXT_DEADLINE_SECONDS=15

LOG_FILE=./logs/gateway.log
AUDIT_LOG_MAX_BYTES=10000000
AUDIT_LOG_BACKUP_COUNT=5
AUDIT_MAX_FIELD_CHARS=4000

# --- Chat workspaces and lifecycle sweeping ---------------------------------
# Attribution mode for host operations: off | tag | strict | enforce.
ATTRIBUTION_MODE=enforce

# Chat workspaces. Each chat gets its own folder under HOST_CHAT_ROOT.
# Enabled by default: requires client binding and per-chat workspaces.
HOST_CHAT_WORKSPACES=true
HOST_CHAT_ROOT=~/Downloads/bqa-workspaces
# Hours without activity before a workspace is archived.
HOST_CHAT_IDLE_ARCHIVE_HOURS=72
# Days an archived workspace is kept before permanent deletion.
HOST_CHAT_RETENTION_DAYS=30
# Cap on simultaneously active workspaces in the root.
HOST_CHAT_MAX_WORKSPACES=128
# Maximum size of a single workspace, in MB.
HOST_CHAT_QUOTA_MB=2048
# When true, writes outside the chat's own workspace are blocked.
HOST_CHAT_ISOLATE=false
# Workspace auth mode: trust_gateway (zero friction auto-continue) | strict_token (requires secret token to resume).
HOST_CHAT_AUTH_MODE=trust_gateway
# Idle minutes after which GPT is nudged to read STATE.md to resume the session.
HOST_CHAT_RESUME_HINT_MINUTES=30

# Footprint cap for the entire workspace root, in GB.
HOST_CHAT_ROOT_MAX_GB=24
# Maximum size of a workspace journal.jsonl (8 MB).
HOST_CHAT_JOURNAL_MAX_BYTES=8388608

# Lifecycle sweeper. The supervisor gate runs hourly and only when
# HOST_CHAT_WORKSPACES=true; sweeps stay dry-run unless APPLY is true.
HOST_CHAT_SWEEP_INTERVAL_MINUTES=60
HOST_CHAT_SWEEP_APPLY=false
