MCP_BIND_HOST=127.0.0.1
MCP_PORT=8000

# Security Credentials
# GATEWAY_TOKEN must be configured with a strong secret. 
# In non-stdio mode (HTTP/SSE), server will reject startup if this is empty.
GATEWAY_TOKEN=

# Allowed target CTF/lab hosts and ports (comma-separated list of host:port)
# Empty by default. No targets are allowed unless explicitly configured here.
ALLOWED_TCP_TARGETS=

# Runner images
RUNNER_IMAGE_PYTHON=ctf-python-runner:latest
RUNNER_IMAGE_PWN=ctf-pwn-runner:latest
RUNNER_IMAGE_SAGE=ctf-sage-runner:latest
RUNS_DIR=./logs/runs
LOG_FILE=./logs/gateway.log
MINIFORGE_PATH=/home/light/miniforge3

# Execution limits
MAX_CODE_BYTES=5000000
MAX_SINGLE_FILE_BYTES=3000000
MAX_OUTPUT_BYTES=500000
MAX_TIMEOUT_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=30
MAX_ARGS=16
MAX_ARG_LENGTH=200

# Security Configurations
ENABLE_ADVANCED_TOOLS=false
ENABLE_WORKSPACE_TOOLS=false
REQUIRE_SANDBOX_FAILURE_REASON=true
REQUIRE_LOCAL_VALIDATION=true

# Keep true to block outgoing connections from Docker sandbox to private IP ranges (e.g. 192.168.x.x, 10.x.x.x, 127.x.x.x)
BLOCK_PRIVATE_IPS=true

# Set to true to enable host-level egress isolation using iptables.
# Note: This requires the host server process to be run with root / sudo permissions to configure docker chains.
ENABLE_EGRESS_FIREWALL=false

DELETE_RUN_FILES_AFTER_DAYS=7

# Docker sandbox resource limits
DOCKER_MEMORY=512m
DOCKER_CPUS=1
DOCKER_PIDS_LIMIT=128
DOCKER_USER=1000:1000

# Agent mode parameters
ENABLE_AGENT_TOOLS=true
AGENT_WORKSPACE_DIR=./mcp_workspace
AGENT_RESTRICT_TO_WORKSPACE=true

# FastMCP Settings
FASTMCP_MESSAGE_PATH=/mcp
